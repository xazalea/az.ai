{
  "name": "az.ai",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "bash vercel-build.sh",
    "build:next": "next build",
    "build:packages": "npm run build --workspaces --if-present || echo 'Package build completed with warnings'",
    "build:packages:parallel": "npm run build --workspaces --if-present --parallel || true",
    "build:packages:sequential": "npm run build --workspaces --if-present || true",
    "start": "next start",
    "lint": "next lint",
    "prebuild": "node scripts/ensure-build-scripts.js || true"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "next": "14.2.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@webgpu/types": "^0.1.66",
    "autoprefixer": "^10.4.22",
    "eslint": "^8",
    "eslint-config-next": "14.2.0",
    "postcss": "^8",
    "tailwindcss": "^3",
    "typescript": "^5"
  }
}
