{
  "buildCommand": "bash vercel-build.sh",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "rewrites": [
    { "source": "/v1/chat/completions", "destination": "/api/unified/v1/chat/completions" },
    { "source": "/v1/images/generations", "destination": "/api/unified/v1/images/generations" },
    { "source": "/v1/videos/generations", "destination": "/api/unified/v1/videos/generations" },
    { "source": "/v2/chat/completions", "destination": "/api/unified/v2/chat/completions" },
    
    { "source": "/v1/reasoning", "destination": "/api/openreason/reason" },
    { "source": "/v1/memory/:path*", "destination": "/api/openmemory/memory/[...path]" },
    { "source": "/api/openreason/:path*", "destination": "/api/openreason/:path*" },
    { "source": "/api/openmemory/:path*", "destination": "/api/openmemory/:path*" },
    
    { "source": "/api/pollinations/:path*", "destination": "/api/pollinations/:path*" },
    { "source": "/api/viggle/:path*", "destination": "/api/viggle/:path*" },
    { "source": "/api/ai-video/:path*", "destination": "/api/ai-video/:path*" },
    
    { "source": "/api/groq/:path*", "destination": "/packages/Groq2API/api/router.go" },
    { "source": "/api/freegpt/:path*", "destination": "/packages/free-gpt3.5-2api/api/router.go" },
    { "source": "/api/deepseekfree/:path*", "destination": "/api/deepseekfree/:path*" },
    { "source": "/api/gemini-multimodal/:path*", "destination": "/api/gemini-multimodal/:path*" },
    { "source": "/api/cliproxy/:path*", "destination": "/packages/CLIProxyAPI/api/router.go" },
    { "source": "/api/imagefx/:path*", "destination": "/api/imagefx/:path*" },
    { "source": "/api/imageai/:path*", "destination": "/api/imageai/:path*" },
    { "source": "/api/video/:path*", "destination": "/api/video/:path*" },
    { "source": "/api/webai/:path*", "destination": "/api/webai/:path*" },
    { "source": "/api/gpt4freejs/:path*", "destination": "/api/gpt4freejs/:path*" },
    { "source": "/api/jimeng-api/:path*", "destination": "/api/jimeng-api/:path*" },
    { "source": "/api/pollinations/:path*", "destination": "/api/pollinations/:path*" },
    { "source": "/api/viggle/:path*", "destination": "/api/viggle/:path*" },
    { "source": "/api/ai-video/:path*", "destination": "/api/ai-video/:path*" }
  ]
}
